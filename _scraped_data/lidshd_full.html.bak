<script>
  (function() {
    const initCustomMegaMenu = () => {
      const links = document.querySelectorAll('.custom-mega-menu-nav-link');
      links.forEach(link => {
        link.addEventListener('mouseenter', () => {
          const tabId = link.getAttribute('data-tab'); 
          const grid = link.closest('.custom-mega-menu__grid');
          if (!grid || !tabId) return;
          
          grid.querySelectorAll('.custom-mega-menu-nav-link').forEach(l => l.classList.remove('active'));
          grid.querySelectorAll('.custom-mega-menu-content-item').forEach(content => content.classList.remove('active'));
          
          link.classList.add('active');
          const activeContent = document.getElementById(tabId);
          if (activeContent) activeContent.classList.add('active');
        });
      });
    };

    document.addEventListener('DOMContentLoaded', initCustomMegaMenu);
    document.addEventListener('shopify:section:load', initCustomMegaMenu);
    // Initialize immediately just in case
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initCustomMegaMenu();
    }
  })();
</script>


