<style data-shopify>
    .archive-popup-pop {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: #0000008c;
        z-index: 9999;
        padding: 40px;
        justify-content: center;
        align-items: center;
    }

    .archive-popup-pop.active {
        display: flex;
    }

    .archive-popup-content {
        height: max-content;
        width: 1800px;
        background: #fff;
        padding: 50px 25px 30px;
        overflow: hidden;
        max-width: 100%;
        max-height: 80vh;
        position: relative;
        overflow: auto;
    }

    .archive-popup-content img {
        width: 100%;
        height: auto;
        display: block;
    }
    .archive-popup-title {
        text-align: center;
        margin-top: 15px;
    }
    .archive-popup-close {
        position: absolute;
        right: 20px;
        top: 10px;
        width: 32px;
        height: 32px;
        border: 0;
        padding: 0;
        background: transparent;
        color: #000;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }
    body.archive-popup-active {
        overflow: hidden;
    }
    @media (max-width:1199px){
        .archive-popup-pop {
            padding: 40px 15px;
        }
        .archive-popup-content {
            padding: 50px 15px 20px;
        }
        .archive-popup-close {
            right: 15px;
        }
    }
    @media (max-width:991px){
        .archive-popup-title {
            font-size: 16px;
            line-height: 1.4;
        }
    }
    @media (max-width:749px){
        .archive-popup-title {
            font-size: 14px;
        }
    }
</style>

