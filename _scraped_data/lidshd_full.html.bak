  <script>
    if (!customElements.get('cart-recommendations-slider')) {
      customElements.define('cart-recommendations-slider', class extends HTMLElement {
        connectedCallback() {
          this._onCartUpdate = () => {
             setTimeout(() => this.init(), 200);
          };
          document.addEventListener('cart:update', this._onCartUpdate);
          
          this.init();
          this.#setupObservers();
        }

        disconnectedCallback() {
          this.observer?.disconnect();
          this.resizeObserver?.disconnect();
          document.removeEventListener('cart:update', this._onCartUpdate);
          if (this.swiper) {
            this.swiper.destroy();
            this.swiper = null;
          }
        }

        #setupObservers() {
          // Detect when the slider becomes visible
          this.observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                this.init();
                if (this.swiper) this.swiper.update();
              }
            });
          }, { threshold: 0 });
          this.observer.observe(this);

          // Handle resizing (e.g. when drawer finishes opening)
          this.resizeObserver = new ResizeObserver(() => {
            if (this.swiper) {
              this.swiper.update();
            } else if (this.offsetWidth > 0) {
              this.init();
            }
          });
          this.resizeObserver.observe(this);
        }

        init() {
          if (this.swiper) {
             this.swiper.update();
             return;
          }

          if (typeof Swiper === 'undefined' || this.offsetWidth === 0) {
            return;
          }

          this.swiper = new Swiper(this, {
            direction: 'horizontal',
            loop: false,
            spaceBetween: 10,
            observer: true,
            observeParents: true,
            breakpoints: {
              0: {
                slidesPerView: 2,
                spaceBetween: 10, 
              },
              420: { 
                slidesPerView: 3,
                spaceBetween: 10,
              }
            },
          });
        } 
      });
    }

    // ─── Cart Recommendation Card Handler ───────────────────────────────────
    // Initialised here (always-present script block) so it runs on first visit
    // even when the cart is empty and the card snippet hasn't been rendered yet.
    // morphSection / morphdom does NOT re-execute <script> tags, so the snippet's
    // own <script> block would never fire after a dynamic cart update.
    if (!window.cartRecommendationsActiveCardHandlerInit) {
      window.cartRecommendationsActiveCardHandlerInit = true;

      // Reset all active / loading states on recommendation cards
      const removeActiveClasses = () => {
        document.querySelectorAll('.cart-drawer__collection-recommendations-card-info').forEach((info) => {
          info.classList.remove('btn-active');
        });
        document.querySelectorAll('.cart-recommendation-add-button').forEach((btn) => {
          btn.classList.remove('loading');
          btn.querySelector('.loading__spinner')?.classList.add('hidden');
        });
      };

      // ── click handler: handles ALL interactions including add-button loading state ── 
      // NOTE: We deliberately do NOT add loading class on 'touchend' because on mobile,
      // touchend fires ~300ms before the synthesised 'click'. Adding pointer-events:none
      // (via .loading CSS) during touchend blocks the click that triggers form.submit.
      const handleClick = (event) => {
        const viewButton = event.target.closest('.cart-recommendation-view-button');
        const addButton  = event.target.closest('.cart-recommendation-add-button');
        const card       = event.target.closest('.cart-drawer__collection-recommendations-card');

        if (viewButton) {
          // Collapse all cards, then expand the clicked one
          document.querySelectorAll('.cart-drawer__collection-recommendations-card-info').forEach((info) => {
            info.classList.remove('btn-active');
          });
          const cardInfo = viewButton.closest('.cart-drawer__collection-recommendations-card-info');
          if (cardInfo) cardInfo.classList.add('btn-active');
          return;
        }

        if (addButton) {
          // Show spinner immediately when add button is clicked
          addButton.classList.add('loading');
          addButton.querySelector('.loading__spinner')?.classList.remove('hidden');

          // Safety timeout: auto-clear if cart:update / cart:error never fires
          const safetyTimer = setTimeout(removeActiveClasses, 8000);
          document.addEventListener('cart:update', () => clearTimeout(safetyTimer), { once: true });
          document.addEventListener('cart:error',  () => clearTimeout(safetyTimer), { once: true });
          return;
        }

        if (!card) {
          // Click outside any recommendation card → collapse all
          document.querySelectorAll('.cart-drawer__collection-recommendations-card-info').forEach((info) => {
            info.classList.remove('btn-active');
          });
        }
      };

      // ── touchend handler: only view-button expand and outside-click collapse ──
      // Does NOT touch loading state (see note above).
      const handleTouchEnd = (event) => {
        const viewButton = event.target.closest('.cart-recommendation-view-button');
        const card       = event.target.closest('.cart-drawer__collection-recommendations-card');

        if (viewButton) {
          document.querySelectorAll('.cart-drawer__collection-recommendations-card-info').forEach((info) => {
            info.classList.remove('btn-active');
          });
          const cardInfo = viewButton.closest('.cart-drawer__collection-recommendations-card-info');
          if (cardInfo) cardInfo.classList.add('btn-active');
          return;
        }

        if (!card) {
          document.querySelectorAll('.cart-drawer__collection-recommendations-card-info').forEach((info) => {
            info.classList.remove('btn-active');
          });
        }
      };

      document.addEventListener('click',    handleClick);
      document.addEventListener('touchend', handleTouchEnd);

      // cart:update covers CartAddEvent + CartUpdateEvent (all bubble to document)
      document.addEventListener('cart:update', removeActiveClasses);
      document.addEventListener('cart:error',  removeActiveClasses);

      // MutationObserver: reset states when morphSection injects fresh card nodes
      // (morphSection fires AFTER cart:update, so new DOM nodes need a second pass)
      const recObserver = new MutationObserver((mutations) => {
        let shouldReset = false;
        for (const mutation of mutations) {
          for (const node of mutation.addedNodes) {
            if (node.nodeType !== Node.ELEMENT_NODE) continue;
            if (
              node.classList?.contains('cart-drawer__collection-recommendations-card') ||
              node.querySelector?.('.cart-drawer__collection-recommendations-card')
            ) {
              shouldReset = true;
              break;
            }
          }
          if (shouldReset) break;
        }
        if (shouldReset) removeActiveClasses();
      });
      recObserver.observe(document.body, { childList: true, subtree: true });
    }
  </script>

